# ==========================================
# Orgflow config — used by invite.sh, create-repo.sh, clone-repos.sh
# Copy this file to orgflow.conf and edit.
# orgflow.conf is git-ignored.
# ==========================================

# GitHub usernames (students) — used by BOTH scripts
# Paste as-is: one per line, no quotes needed
USERS="student-username-1
student-username-2"

# Organization name — used by ALL scripts
# (invite.sh, create-repo.sh, clone-repos.sh)
ORG="YOUR-ORG"

# Cohort team name — used by BOTH scripts
# Prefixes repo names in create-repo.sh (e.g. "hck-99-assignment-<user>")
TEAM_NAME="hck-100"

# Reviewers — instructors/TA (create-repo.sh only)
# Plain space/newline-separated list — no quotes needed
# Optional: leave empty to skip assigning reviewers
REVIEWERS="instructor-username"

# Template repositories + submission deadlines (create-repo.sh only)
# Format: "repository|YYYY-MM-DD HH:MM" (deadline in WIB)
# The org is taken from ORG above — just the repo name here.
# Deadline optional; without it, milestone/issue creation is skipped
TEMPLATES=(
    "assignment-template|2026-08-31 23:59"
)

# Clone base directory — clone-repos.sh only
# Repos land in $CLONE_DIR/<template>/<repo>/. Optional, defaults to current dir.
CLONE_DIR="cloneResult"
